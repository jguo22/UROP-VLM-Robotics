-            var cosAlpha = Mathf.Cos(alpha);
-            var sinAlpha = Mathf.Sin(alpha);
-
-            return new Matrix4x4
-            {
-                m00 = cosTheta * cosAlpha,
-                m10 = -sinAlpha,
-                m20 = sinTheta * cosAlpha,
-                m30 = 0,
-                
-                m01 = cosTheta * sinAlpha,
-                m11 = cosAlpha,
-                m21 = sinTheta * sinAlpha,
-                m31 = 0,
-                
-                m02 = -sinTheta,
-                m12 = 0,
-                m22 = cosTheta,
-                m32 = 0,
-
-                m03 = -a * sinTheta,
-                m13 = d,
-                m23 = a * cosTheta,
-                m33 = 1
-            };
-        }
